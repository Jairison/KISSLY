{
  "expo": {
    "name": "Kissly",
    "slug": "kissly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kissly.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0810",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kissly.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Kissly precisa acessar suas fotos para você montar seu perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Kissly usa sua localização para mostrar pessoas perto de você."
        }
      ]
    ],
    "scheme": "kissly",
    "backgroundColor": "#0B0810",
    "experiments": {
      "typedRoutes": true
    }
  }
}
