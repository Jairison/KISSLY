# Copie para .env e preencha com os dados do seu projeto Supabase
# (Painel do Supabase → Project Settings → API Keys)
# Sem esses valores o app roda no modo de demonstração local.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Assinaturas (RevenueCat → Project settings → API keys → chaves públicas por plataforma)
# Sem elas, com o Supabase ligado, a tela de planos mostra os preços mas não deixa comprar.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_...
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...
